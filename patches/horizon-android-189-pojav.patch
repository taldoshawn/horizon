diff --git a/.github/workflows/legacy-18-tests.yml b/.github/workflows/legacy-18-tests.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/legacy-18-tests.yml
@@ -0,0 +1,46 @@
+name: Java 1.8 (protocol 47) codec tests
+on:
+  push:
+    branches: [main, android]
+    paths:
+      - 'crates/horizon-protocol/**'
+      - 'Cargo.toml'
+      - 'Cargo.lock'
+      - 'rust-toolchain.toml'
+      - '.github/workflows/legacy-18-tests.yml'
+      - 'packaging/android/legacy-proxy/**'
+      - 'tests/test_legacy_proxy_helper.py'
+      - 'tests/test_android_launcher_bridge.py'
+      - 'crates/horizon-client/src/android/**'
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  protocol-47:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 35
+    env:
+      CARGO_BUILD_JOBS: '2'
+      CARGO_PROFILE_DEV_DEBUG: '0'
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4
+        with:
+          persist-credentials: false
+      - name: Install selected Rust version
+        run: rustup show
+      - uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
+        with:
+          path: |
+            ~/.cargo/registry
+            ~/.cargo/git
+            target
+          key: legacy18-${{ runner.os }}-${{ hashFiles('Cargo.lock', 'rust-toolchain.toml') }}
+      - name: Termux proxy helper offline tests
+        run: |
+          bash -n packaging/android/legacy-proxy/start-termux.sh
+          python3 tests/test_legacy_proxy_helper.py
+          python3 tests/test_android_launcher_bridge.py
+      - name: Rust protocol 47 tests and mocked offline login
+        run: cargo test --locked -p horizon-protocol legacy_v1_8 --lib
+      - name: Rust 1.8 diagnostic probe type-check
+        run: cargo check --locked -p horizon-protocol --example legacy18_probe
