+        assert_eq!(r.f64().unwrap(), 102.0);
+        assert_eq!(r.f64().unwrap(), 62.0);
+        assert_eq!(r.f64().unwrap(), 3.0);
+        assert_eq!(r.f32().unwrap(), 10.0);
+        assert_eq!(r.f32().unwrap(), 25.0);
